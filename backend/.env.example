# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/phoenixcare

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# OTP
OTP_EXPIRES_MINUTES=5

# Cloudinary (file/image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Twilio (SMS/WhatsApp OTP + notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Firebase Cloud Messaging — not used; kept as an optional upgrade path for native mobile push
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Email (SMTP) — OTP emails, booking/cancellation/prescription notifications.
# Any SMTP provider works (Gmail app password, Resend, Mailtrap for dev, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PhoenixCare <no-reply@phoenixcare.demo>

# Web Push (installable browser push notifications) — generate your own keypair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# This is a self-generated keypair, not a third-party account — safe to create locally.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:support@phoenixcare.demo

# Video/Audio (optional upgrade path from built-in WebRTC signaling)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# AI booking assistant (optional). Leave ANTHROPIC_API_KEY unset to run in guided mode without AI.
ANTHROPIC_API_KEY=
AI_ASSISTANT_MODEL=claude-opus-5-5
AI_ASSISTANT_EFFORT=low
AI_ASSISTANT_DAILY_CAP=1000
